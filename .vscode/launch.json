    "version": "0.2.0",
    "configurations": [
        {
            "name": "powerpc-lauch",
            "cwd": "${workspaceFolder}",
            "executable": "build/freertos_mpc5744p.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "external",
            "showDevDebugOutput": "raw",
            "debuggerArgs": [
                "-nx",
                "-ex", "set architecture powerpc:common",
