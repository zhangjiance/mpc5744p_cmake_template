            "preLaunchTask": "Start-pegdbserver",
            "objdumpPath": "powerpc-eabivle-objdump",
            "gdbPath": "gdb-multiarch",
            "gdbTarget": ":7224"
        },
        {
            "name": "powerpc-attach",
            "cwd": "${workspaceFolder}",
            "executable": "build/GateBoot_Z4.elf",
            "request": "attach",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "external",
            "showDevDebugOutput": "raw",
            "debuggerArgs": [
                "-nx",
                "-ex", "set architecture powerpc:common",
            ],
            "preLaunchTask": "Start-pegdbserver",
            "objdumpPath": "powerpc-eabivle-objdump.exe",
            "gdbPath": "gdb-multiarch.exe",
            "gdbTarget": ":7224"
        },
    ]
